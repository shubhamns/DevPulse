NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/devpulse
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Auth (use 32+ chars in production)
# Also used as pepper for API key hashing, GitHub token encryption, and OAuth state signing.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
EVENT_RATE_LIMIT_WINDOW_MS=60000
EVENT_RATE_LIMIT_MAX=120

# AI (leave OPENAI_API_KEY empty to disable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub OAuth (leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/github/callback
